[Unit]
Description=Compositor-neutral workspace D-Bus service
# Session readiness includes compositor socket/environment publication.
After=graphical-session.target
Requisite=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.rsynapse.Workspace
ExecStart=@LOCAL_BIN@/rsynapse-workspace-dbus --backend auto
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=graphical-session.target
Alias=workspace-dbus.service
