[Unit]
Description=Compositor-neutral workspace D-Bus service
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.rsynapse.Workspace
ExecStart=@LOCAL_BIN@/workspace-dbus --backend auto
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=graphical-session.target
