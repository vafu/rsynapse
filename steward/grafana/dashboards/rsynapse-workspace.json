{
  "uid": "rsynapse-workspace",
  "title": "Rsynapse workspace",
  "tags": [
    "rsynapse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "description": "Workspace detail page shared by all recorded contexts. Open from a slice in the overview's Workspace breakdown pie.",
  "links": [
    {
      "type": "link",
      "title": "Focus overview",
      "url": "/d/rsynapse-focus/rsynapse-focus",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "workspace_name",
        "label": "Workspace / project",
        "type": "query",
        "description": "Recorded workspace context; selected by the clicked pie slice or this dropdown.",
        "datasource": {
          "type": "graphite",
          "uid": "graphite"
        },
        "query": {
          "refId": "workspace-names",
          "queryType": "Default",
          "target": "rsynapse.focus.workspace_name.*"
        },
        "definition": "rsynapse.focus.workspace_name.*",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": []
      },
      {
        "name": "idle",
        "label": "Activity",
        "type": "custom",
        "query": "Active : false, Idle : true",
        "multi": false,
        "includeAll": true,
        "allValue": "*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "Active",
            "value": "false",
            "selected": false
          },
          {
            "text": "Idle",
            "value": "true",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 12,
      "type": "piechart",
      "title": "App usage \u2014 $workspace_name",
      "maxDataPoints": 1000000,
      "description": "Joint app/context focus durations within the selected range and Activity filter.",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "chrome"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B877D9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "codex"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FADE2A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "firefox"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C2D1FF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ghostty"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F29191"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "neovim"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "opencode"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#56D9D3"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "slack"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B3A2F7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "update-manager"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "pie",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "target": "groupByNode(consolidateBy(setXFilesFactor(rsynapse.focus.workspace_name.${workspace_name:glob}.app.*.idle.${idle:raw}.seconds, 0), 'sum'), 5, 'sum')"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Idle percentage",
      "maxDataPoints": 1000000,
      "description": "100 \u00d7 summed idle duration \u00f7 summed total duration for the selected range. Independent of the Activity filter; no measured time displays No data.",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "target": "alias(asPercent(aggregateLine(fallbackSeries(transformNull(sumSeries(consolidateBy(setXFilesFactor(rsynapse.focus.workspace_name.${workspace_name:glob}.idle.true.seconds, 0), 'sum')), 0), constantLine(0)), 'sum'), aggregateLine(fallbackSeries(transformNull(sumSeries(consolidateBy(setXFilesFactor(rsynapse.focus.workspace_name.${workspace_name:glob}.idle.*.seconds, 0), 'sum')), 0), constantLine(0)), 'sum')), 'Idle percentage')"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Total focus time",
      "maxDataPoints": 1000000,
      "description": "Active + idle workspace duration. Independent of the Activity filter; includes time with no app window focused.",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "target": "alias(sumSeries(consolidateBy(setXFilesFactor(rsynapse.focus.workspace_name.${workspace_name:glob}.idle.*.seconds, 0), 'sum')), 'Total focus time')"
        }
      ]
    },
    {
      "id": 15,
      "type": "piechart",
      "title": "Active / idle",
      "maxDataPoints": 1000000,
      "description": "Both activity states for this workspace and selected range, independent of the Activity filter.",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "pieType": "pie",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "target": "alias(sumSeries(consolidateBy(setXFilesFactor(rsynapse.focus.workspace_name.${workspace_name:glob}.idle.false.seconds, 0), 'sum')), 'Active')"
        },
        {
          "refId": "B",
          "target": "alias(sumSeries(consolidateBy(setXFilesFactor(rsynapse.focus.workspace_name.${workspace_name:glob}.idle.true.seconds, 0), 'sum')), 'Idle')"
        }
      ]
    },
    {
      "id": 17,
      "type": "state-timeline",
      "title": "Focus state \u2014 $workspace_name",
      "description": "This workspace's active/idle/not-focused periods. Independent of the Activity filter.",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not focused",
                  "color": "gray"
                },
                "1": {
                  "text": "Active focus"
                },
                "2": {
                  "text": "Idle focus"
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "android_snapchat"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FFCC99"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "coro-db"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#DEB6F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "coro-ncm"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C2D1FF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "coro-uiq"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "coroutines-startup-sanity"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B877D9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "e2e-lsp"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F29191"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "empty"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "office"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FFB357"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "personal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B8E986"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rsynapse"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8AB8FF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "test"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "vivid-grove"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#56D9D3"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.9
      },
      "targets": [
        {
          "refId": "A",
          "target": "aliasByNode(consolidateBy(keepLastValue(rsynapse.focus.workspace_name.${workspace_name:glob}.state), 'last'), 3)"
        }
      ]
    }
  ]
}
