{
  "uid": "rsynapse-focus",
  "title": "Rsynapse focus",
  "tags": ["rsynapse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Focus seconds by project",
      "datasource": { "type": "graphite", "uid": "graphite" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "refId": "A",
          "target": "aliasByNode(rsynapse.focus.project.*.seconds, 3)"
        }
      ]
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "App breakdown (24h)",
      "datasource": { "type": "graphite", "uid": "graphite" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "target": "aliasByNode(summarize(rsynapse.focus.app.*.seconds, '24h', 'sum', true), 3)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Workspace switches (today)",
      "datasource": { "type": "graphite", "uid": "graphite" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 8 },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "target": "summarize(sumSeries(rsynapse.switches.workspace), '1d', 'sum')"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Switches per hour",
      "datasource": { "type": "graphite", "uid": "graphite" },
      "gridPos": { "h": 4, "w": 16, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "target": "summarize(sumSeries(rsynapse.switches.workspace), '1h', 'sum')"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Focus seconds by workspace",
      "datasource": { "type": "graphite", "uid": "graphite" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "target": "aliasByNode(rsynapse.focus.workspace.*.seconds, 3)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Focus seconds by session",
      "description": "Inner session from locus app-instance relations (editor, agent, …). Plain windows have no session entry.",
      "datasource": { "type": "graphite", "uid": "graphite" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "refId": "A",
          "target": "aliasByNode(rsynapse.focus.session.*.seconds, 3)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Focus seconds by workspace name",
      "description": "Project display name for project-native workspaces; merges workspaces sharing a project and survives workspace-id churn.",
      "datasource": { "type": "graphite", "uid": "graphite" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "refId": "A",
          "target": "aliasByNode(rsynapse.focus.workspace_name.*.seconds, 3)"
        }
      ]
    }
  ]
}
