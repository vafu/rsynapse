    {
      "id": 1,
      "type": "state-timeline",
      "title": "Focused project",
      "description": "One categorical lane showing the focused project. Idle retains the same name; None means unassigned, locked, or no focus.",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "(none)": {
                  "text": "None",
                  "color": "gray"
                },
                "coro-db": {
                  "text": "coro-db",
                  "color": "#DEB6F2"
                },
                "coro-ncm": {
                  "text": "coro-ncm",
                  "color": "#C2D1FF"
                },
                "coroutines-startup-sanity": {
                  "text": "coroutines-startup-sanity",
                  "color": "#B877D9"
                },
                "e2e-lsp": {
                  "text": "e2e-lsp",
                  "color": "#F29191"
                },
                "rsynapse": {
                  "text": "rsynapse",
                  "color": "#8AB8FF"
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "always",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "target": "group(aliasByNode(consolidateBy(keepLastValue(rsynapse.focus.project.*.state), 'last'), 3), alias(consolidateBy(keepLastValue(rsynapse.focus.no_project.state), 'last'), '(none)'))"
        }
      ],
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "Value",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value": true
            },
            "renameByName": {
              "Metric": "Focused project"
            }
          }
        }
      ]
    },
