        },
        {
          "refId": "B",
          "target": "alias(sumSeries(consolidateBy(setXFilesFactor(rsynapse.focus.workspace.*.idle.true.seconds, 0), 'sum')), 'Idle')"
        },
        {
          "refId": "C",
          "target": "alias(consolidateBy(setXFilesFactor(rsynapse.activity.locked.seconds, 0), 'sum'), 'Locked')"
        }
      ]
    },
