    {
      "id": 9,
      "type": "piechart",
      "title": "Activity breakdown",
      "maxDataPoints": 1000000,
      "description": "Active/idle totals derive from workspace durations. Locked time is separate. Always includes both idle states.",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "min": 0
