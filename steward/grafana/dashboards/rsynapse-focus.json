{
  "uid": "rsynapse-focus",
  "title": "Rsynapse focus",
  "tags": [
    "rsynapse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 7,
  "templating": {
    "list": [
      {
        "name": "idle",
        "label": "Activity",
        "type": "custom",
        "query": "Active : false, Idle : true",
        "multi": false,
        "includeAll": true,
        "allValue": "*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "Active",
            "value": "false",
            "selected": false
          },
          {
            "text": "Idle",
            "value": "true",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 8,
      "type": "piechart",
      "title": "Project breakdown",
      "maxDataPoints": 1000000,
      "description": "Completed project focus intervals in the selected range and Activity filter. Unassigned and locked time is excluded.",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "coro-db"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#DEB6F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "coro-ncm"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C2D1FF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "coroutines-startup-sanity"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B877D9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "e2e-lsp"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F29191"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rsynapse"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8AB8FF"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "pie",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "target": "groupByNode(consolidateBy(setXFilesFactor(rsynapse.focus.project.*.idle.${idle:raw}.seconds, 0), 'sum'), 3, 'sum')"
        }
      ]
    },
