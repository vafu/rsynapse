{
  "uid": "rsynapse-workday",
  "title": "Rsynapse workday",
  "tags": ["rsynapse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-30d", "to": "now"},
  "refresh": "30s",
  "links": [{"type": "link", "title": "Focus overview", "url": "/d/rsynapse-focus/rsynapse-focus", "keepTime": true}],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Today — start and finish",
      "description": "Local-calendar-day start is first active presence. Span finish = start + 8 hours. Earliest finish satisfies 8 hours elapsed, 8 hours unlocked and 4 hours active, assuming you remain active and unlocked from now. Includes live time since the last event without a collector timer.",
      "timeFrom": "now/d", "hideTimeOverride": true, "maxDataPoints": 1000000,
      "datasource": {"type": "graphite", "uid": "graphite"},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "dateTimeAsIso", "noValue": "Not started", "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "graphMode": "none", "textMode": "value_and_name", "orientation": "horizontal", "colorMode": "value"},
      "targets": [
        {"refId": "A", "target": "alias(scale(keepLastValue(rsynapse.workday.today.started.state), 1000), 'Started')"},
        {"refId": "B", "target": "alias(scale(keepLastValue(rsynapse.workday.today.planned_finish.state), 1000), '8-hour span finish')"},
        {"refId": "C", "target": "alias(scale(multiplySeries(maxSeries(keepLastValue(rsynapse.workday.today.planned_finish.state), sumSeries(scale(constantLine(${__to}), 0.001), maxSeries(constantLine(0), diffSeries(constantLine(28800), sumSeries(keepLastValue(rsynapse.workday.today.unlocked_seconds.state), multiplySeries(keepLastValue(rsynapse.workday.today.unlocked.state), maxSeries(constantLine(0), diffSeries(scale(constantLine(${__to}), 0.001), keepLastValue(rsynapse.workday.today.checkpoint.state)))))), diffSeries(constantLine(14400), sumSeries(keepLastValue(rsynapse.workday.today.active_seconds.state), multiplySeries(keepLastValue(rsynapse.workday.today.active.state), maxSeries(constantLine(0), diffSeries(scale(constantLine(${__to}), 0.001), keepLastValue(rsynapse.workday.today.checkpoint.state))))))))), divideSeries(keepLastValue(rsynapse.workday.today.started.state), keepLastValue(rsynapse.workday.today.started.state))), 1000), 'Earliest finish — all targets')"}
      ]
    },
    {
      "id": 2, "type": "stat", "title": "Today — over / under targets",
      "description": "Negative = still under target; positive = over target. Elapsed span runs from first active to latest active presence, including breaks between them. Unlocked includes idle but excludes lock, starting at first active. Active excludes idle and lock. Midnight and DST use the session's local calendar.",
      "timeFrom": "now/d", "hideTimeOverride": true, "maxDataPoints": 1000000,
      "datasource": {"type": "graphite", "uid": "graphite"},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 5},
      "fieldConfig": {"defaults": {"unit": "s", "noValue": "Not started", "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}, {"color": "green", "value": 0}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "graphMode": "none", "textMode": "value_and_name", "orientation": "horizontal", "colorMode": "value"},
      "targets": [
        {"refId": "A", "target": "alias(offset(sumSeries(diffSeries(keepLastValue(rsynapse.workday.today.last_active.state), keepLastValue(rsynapse.workday.today.started.state)), multiplySeries(keepLastValue(rsynapse.workday.today.active.state), maxSeries(constantLine(0), diffSeries(scale(constantLine(${__to}), 0.001), keepLastValue(rsynapse.workday.today.checkpoint.state))))), -28800), 'Elapsed vs 8h')"},
        {"refId": "B", "target": "alias(offset(sumSeries(keepLastValue(rsynapse.workday.today.unlocked_seconds.state), multiplySeries(keepLastValue(rsynapse.workday.today.unlocked.state), maxSeries(constantLine(0), diffSeries(scale(constantLine(${__to}), 0.001), keepLastValue(rsynapse.workday.today.checkpoint.state))))), -28800), 'Unlocked vs 8h')"},
        {"refId": "C", "target": "alias(offset(sumSeries(keepLastValue(rsynapse.workday.today.active_seconds.state), multiplySeries(keepLastValue(rsynapse.workday.today.active.state), maxSeries(constantLine(0), diffSeries(scale(constantLine(${__to}), 0.001), keepLastValue(rsynapse.workday.today.checkpoint.state))))), -14400), 'Active vs 4h')"}
      ]
    },
    {
      "id": 3, "type": "stat", "title": "Today — unlocked and active totals",
      "timeFrom": "now/d", "hideTimeOverride": true, "maxDataPoints": 1000000,
      "description": "Live totals after today's first active presence. Unlocked target is 8h; active target is 4h. Unlike completed-interval focus panels, these include the open interval using the last recorded activity flags.",
      "datasource": {"type": "graphite", "uid": "graphite"},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 10},
      "fieldConfig": {"defaults": {"unit": "dtdurations", "min": 0, "noValue": "Not started"}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "graphMode": "none", "textMode": "value_and_name", "orientation": "horizontal"},
      "targets": [
        {"refId": "A", "target": "alias(sumSeries(keepLastValue(rsynapse.workday.today.unlocked_seconds.state), multiplySeries(keepLastValue(rsynapse.workday.today.unlocked.state), maxSeries(constantLine(0), diffSeries(scale(constantLine(${__to}), 0.001), keepLastValue(rsynapse.workday.today.checkpoint.state))))), 'Unlocked — target 8h')"},
        {"refId": "B", "target": "alias(sumSeries(keepLastValue(rsynapse.workday.today.active_seconds.state), multiplySeries(keepLastValue(rsynapse.workday.today.active.state), maxSeries(constantLine(0), diffSeries(scale(constantLine(${__to}), 0.001), keepLastValue(rsynapse.workday.today.checkpoint.state))))), 'Active — target 4h')"}
      ]
    },
    {
      "id": 4, "type": "table", "title": "Daily workday log",
      "description": "Durable local-calendar-day records stored by steward in locus. Latest recorded values per day: span finish, last active, unlocked/active totals, and signed target differences. Today may lag the live panels until the next activity/focus event. Historical rows survive steward restarts.",
      "datasource": {"type": "graphite", "uid": "graphite"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 15},
      "fieldConfig": {"defaults": {"unit": "dtdurations", "noValue": "—"}, "overrides": [
        {"matcher": {"id": "byName", "options": "Started"}, "properties": [{"id": "unit", "value": "dateTimeAsIso"}]},
        {"matcher": {"id": "byName", "options": "Span finish"}, "properties": [{"id": "unit", "value": "dateTimeAsIso"}]},
        {"matcher": {"id": "byName", "options": "Last active"}, "properties": [{"id": "unit", "value": "dateTimeAsIso"}]},
        {"matcher": {"id": "byRegexp", "options": "vs"}, "properties": [{"id": "unit", "value": "s"}]}
      ]},
      "options": {"showHeader": true, "sortBy": [{"displayName": "Day", "desc": true}]},
      "targets": [{"refId": "A", "target": "aliasSub(aliasByNode(consolidateBy(keepLastValue(rsynapse.workday.20*.{started,planned_finish,last_active,span_delta,unlocked_delta,active_delta,active_seconds,unlocked_seconds}.state), 'last'), 2, 3), '^(.*)\\.(.*)$', '{\"Day\":\"\\1\",\"Metric\":\"\\2\"}')"}],
      "transformations": [
        {"id": "reduce", "options": {"mode": "seriesToRows", "reducers": ["lastNotNull"]}},
        {"id": "extractFields", "options": {"source": "Field", "format": "json", "replace": false}},
        {"id": "groupingToMatrix", "options": {"columnField": "Metric", "rowField": "Day", "valueField": "Last *"}},
        {"id": "calculateField", "options": {"mode": "binary", "binary": {"left": "started", "operator": "*", "right": "1000"}, "alias": "Started"}},
        {"id": "calculateField", "options": {"mode": "binary", "binary": {"left": "planned_finish", "operator": "*", "right": "1000"}, "alias": "Span finish"}},
        {"id": "calculateField", "options": {"mode": "binary", "binary": {"left": "last_active", "operator": "*", "right": "1000"}, "alias": "Last active"}},
        {"id": "organize", "options": {"excludeByName": {"started": true, "planned_finish": true, "last_active": true}, "renameByName": {"Day\\Metric": "Day", "span_delta": "Elapsed vs 8h", "unlocked_delta": "Unlocked vs 8h", "active_delta": "Active vs 4h", "active_seconds": "Active", "unlocked_seconds": "Unlocked"}}}
      ]
    }
  ]
}
